{
  "name": "aethera-server",
  "version": "1.0.0",
  "description": "Backend REST API server for Aethera Commerce",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seeds/seed.js",
    "seed:clear": "node src/seeds/seed.js --clear",
    "seed:admin": "node src/seeds/seedAdmin.js",
    "test:auth": "node test/authTest.js",
    "test:product": "node test/productTest.js",
    "test:checkout": "node test/checkoutTest.js",
    "test:review": "node test/reviewTest.js",
    "test:customization": "node test/customizationTest.js",
    "test:interaction": "node test/interactionTest.js",
    "test:recommendation": "node test/recommendationTest.js",
    "test:embedding": "node test/embeddingTest.js",
    "test:semantic-search": "node test/semanticSearchTest.js",
    "test:ai": "node test/aiAssistantTest.js",
    "test:review-summary": "node test/reviewSummaryTest.js",
    "embeddings:generate": "node src/scripts/generateEmbeddings.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "keywords": [
    "express",
    "api",
    "aethera"
  ],
